{
  "rewrites": [
    {
      "source": "/api/leads/:path*",
      "destination": "/api/leads"
    },
    {
      "source": "/api/leads",
      "destination": "/api/leads"
    },
    {
      "source": "/api/smtp/verify",
      "destination": "/api/leads"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
