RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Protect leads_database.json from direct public browser download
<Files "leads_database.json">
    Order allow,deny
    Deny from all
</Files>

# Do not rewrite API requests to PHP
RewriteRule ^api/ - [L]

# Single Page Application (SPA) rewrite to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /index.html [L]
