DirectoryIndex index.php index.html

# 1. Force strict MIME types
AddType application/javascript .js .mjs
AddType text/javascript .js
AddType text/css .css
AddType image/svg+xml .svg

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

# 2. Allow CORS
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# 3. URL Rewrite & Routing to index.php
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Protect leads_database.json from direct public browser download
<Files "leads_database.json">
  Order allow,deny
  Deny from all
</Files>

# Do not rewrite API requests to PHP scripts directly
RewriteRule ^api/ - [L]

# Single Page Application (SPA) rewrite to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /index.php [L]
